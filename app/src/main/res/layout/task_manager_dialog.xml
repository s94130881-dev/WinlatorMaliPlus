<?xml version="1.0" encoding="utf-8"?>

<HorizontalScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="240dp"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- ========================================================= -->
        <!-- PROCESS LIST                                               -->
        <!-- ========================================================= -->

        <LinearLayout
            android:layout_width="400dp"
            android:layout_height="match_parent"
            android:background="@drawable/bordered_panel_dark"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Table Header -->
            <LinearLayout
                android:id="@+id/LLTableHead"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/badge_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <View
                    android:layout_width="30dp"
                    android:layout_height="1dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="2dp"
                    android:text="@string/process_name"
                    android:textColor="?attr/colorAccent"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/pid"
                    android:textColor="?attr/colorAccent"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:paddingEnd="8dp"
                    android:text="@string/memory"
                    android:textColor="?attr/colorAccent"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="36dp"
                    android:layout_height="1dp" />

            </LinearLayout>

            <!-- Process List -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="140dp">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbarStyle="insideOverlay"
                    android:scrollbars="vertical">

                    <LinearLayout
                        android:id="@+id/LLProcessList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </ScrollView>

                <TextView
                    android:id="@+id/TVEmptyText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/no_items_to_display"
                    android:textColor="?android:attr/textColorSecondary"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>


        <!-- ========================================================= -->
        <!-- RIGHT INFORMATION PANEL                                   -->
        <!-- ========================================================= -->

        <ScrollView
            android:layout_width="150dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <!-- ================================================= -->
                <!-- CPU PANEL                                          -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bordered_panel_dark"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/TVCPUTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:textColor="?attr/colorAccent"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/LLCPUInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>


                <!-- ================================================= -->
                <!-- MEMORY PANEL                                       -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bordered_panel_dark"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <!-- Memory title -->
                    <TextView
                        android:id="@+id/TVMemoryTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:textColor="?attr/colorAccent"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />


                    <!-- ================================================= -->
                    <!-- MEMORY SELECTOR                                     -->
                    <!-- ================================================= -->

                    <LinearLayout
                        android:id="@+id/LLMemorySelector"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingEnd="2dp">

                        <!-- Current RAM information -->
                        <TextView
                            android:id="@+id/TVMemoryInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textColor="#FFFFFF"
                            android:textSize="11.5sp" />

                        <!-- Dropdown arrow -->
                        <TextView
                            android:id="@+id/TVMemoryArrow"
                            android:layout_width="24dp"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="▼"
                            android:textColor="?attr/colorAccent"
                            android:textSize="10sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</HorizontalScrollView>
